CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
PORT=3080
SYNC_INTERVAL_MINUTES=15
# Configure only when a public HTTPS webhook receiver is available.
CDEK_WEBHOOK_SECRET=

# Optional for local development; mandatory together on a public deployment.
# In production use NODE_ENV=production and an HTTPS origin without a trailing slash.
# APP_ORIGIN=https://snowbrick.ru
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD_HASH='scrypt$<salt>$<hash>'
